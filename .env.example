# Tavily MCP 服务器配置示例
# 复制为 .env 并填写真实值

# 服务器监听端口
PORT=8080

# Tavily API Key
# 单 key：直接填一个；多 key 轮询：用 TAVILY_API_KEYS 逗号分隔，多填几个
# TAVILY_API_KEY=tvly-single-key

# 多密钥轮询（推荐）：逗号分隔，至少一个
# 密钥池会自动轮询分配请求；某个 key 触发 401/429/432/433 时自动切换到下一个
TAVILY_API_KEYS=tvly-key1,tvly-key2,tvly-key3

# ---------------------------------------------------------------------------
# 面板管控的搜索参数（AI 不可修改，只能通过这里/面板配置）
# 这些参数不进入 MCP tool 的 inputSchema，AI 在调用时无法设置
# ---------------------------------------------------------------------------

# 是否在结果中附带 LLM 生成的答案。取值：true / false / basic / advanced
# TAVILY_INCLUDE_ANSWER=false

# 是否附带清洗后的原始内容。取值：true / false / markdown / text
# TAVILY_INCLUDE_RAW_CONTENT=false

# 是否包含图片
# TAVILY_INCLUDE_IMAGES=false

# 是否包含图片描述（需 TAVILY_INCLUDE_IMAGES=true）
# TAVILY_INCLUDE_IMAGE_DESCRIPTIONS=false

# 是否包含站点图标
# TAVILY_INCLUDE_FAVICON=false

# 每个来源返回的内容片段数，1-3
# TAVILY_CHUNKS_PER_SOURCE=3

# 仅在这些域名内搜索，逗号分隔，最多 300 个
# TAVILY_INCLUDE_DOMAINS=

# 排除这些域名，逗号分隔，最多 150 个
# TAVILY_EXCLUDE_DOMAINS=

# 提升指定国家的搜索结果（小写国家名，如 china、united states）
# TAVILY_COUNTRY=

# 自动配置搜索参数（开启后 search_depth 可能自动升级为 advanced，消耗 2 credits）
# TAVILY_AUTO_PARAMETERS=false
